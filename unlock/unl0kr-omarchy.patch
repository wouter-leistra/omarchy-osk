+static void omarchy_textarea_changed_cb(lv_event_t *event) {
+    lv_obj_t *textarea = lv_event_get_target(event);
+    bool empty = lv_textarea_get_text(textarea)[0] == '\0';
+    lv_obj_set_style_opa(textarea, empty ? LV_OPA_TRANSP : LV_OPA_COVER, LV_PART_CURSOR | LV_STATE_FOCUSED);
