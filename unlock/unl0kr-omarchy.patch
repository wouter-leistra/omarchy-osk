+
+/* The blurred wallpaper behind everything, from a raw XRGB8888 file */
+static lv_image_dsc_t omarchy_wallpaper;
+
+static void create_omarchy_wallpaper(lv_obj_t *screen, int32_t hor_res, int32_t ver_res) {
+    const ul_config_opts_omarchy *o = &conf_opts.omarchy;
+    if (!o->wallpaper || o->wallpaper_width <= 0 || o->wallpaper_height <= 0)
+        return;
+    uint32_t size = (uint32_t)o->wallpaper_width * (uint32_t)o->wallpaper_height * 4;
+    FILE *f = fopen(o->wallpaper, "rb");
+    if (!f)
+        return;
+    uint8_t *data = malloc(size);
+    if (!data || fread(data, 1, size, f) != size) {
+        free(data);
+        fclose(f);
+        return;
+    }
+    fclose(f);
+
+    memset(&omarchy_wallpaper, 0, sizeof(omarchy_wallpaper));
+    omarchy_wallpaper.header.magic = LV_IMAGE_HEADER_MAGIC;
+    omarchy_wallpaper.header.cf = LV_COLOR_FORMAT_XRGB8888;
+    omarchy_wallpaper.header.w = o->wallpaper_width;
+    omarchy_wallpaper.header.h = o->wallpaper_height;
+    omarchy_wallpaper.header.stride = o->wallpaper_width * 4;
+    omarchy_wallpaper.data_size = size;
+    omarchy_wallpaper.data = data;
+
+    lv_obj_t *image = lv_image_create(screen);
+    lv_obj_add_flag(image, LV_OBJ_FLAG_IGNORE_LAYOUT | LV_OBJ_FLAG_FLOATING);
+    lv_obj_remove_flag(image, LV_OBJ_FLAG_CLICKABLE);
+    lv_obj_set_pos(image, 0, 0);
+    lv_obj_set_size(image, hor_res, ver_res);
+    lv_image_set_src(image, &omarchy_wallpaper);
+    if (o->wallpaper_width != hor_res || o->wallpaper_height != ver_res)
+        lv_image_set_inner_align(image, LV_IMAGE_ALIGN_COVER);
+}
