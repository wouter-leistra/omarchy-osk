[Unit]
Description=Show the on-screen keyboard for focused text fields while the Type Cover is detached
After=graphical-session.target omarchy-fcitx5.service
PartOf=graphical-session.target
ConditionEnvironment=WAYLAND_DISPLAY

[Service]
Type=simple
ExecStart=%h/.local/bin/omarchy-osk-autoshow
Restart=on-failure
RestartSec=2

[Install]
WantedBy=graphical-session.target
