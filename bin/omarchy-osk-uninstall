#!/bin/bash
# Remove omarchy-osk: the keyboard, its scripts and data, the auto-show
# service, the bar button, the theme/font/update hooks, the patched copies
# of Omarchy's menu, theme switcher and lock screen (Omarchy's own come
# back) and the Hyprland layer rule it added.
#
#   omarchy-osk-uninstall                 your settings stay in ~/.config/omarchy-osk
#   omarchy-osk-uninstall --purge         remove those too
#   omarchy-osk-uninstall --patches-only  only go back to Omarchy's own menu,
#                                         theme switcher and lock screen
set -uo pipefail

PREFIX="${OSK_PREFIX:-$HOME/.local}"
CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}"
STATE="${XDG_STATE_HOME:-$HOME/.local/state}/omarchy-osk"
CACHE="${XDG_CACHE_HOME:-$HOME/.cache}/omarchy-osk"
PLUGINS="$CONFIG_DIR/omarchy/plugins"
LAYER_FILE="$CONFIG_DIR/hypr/looknfeel.lua"

purge=0 patches_only=0
for a in "$@"; do
  case $a in
    --purge) purge=1 ;;
    --patches-only) patches_only=1 ;;
    -h|--help) sed -n '2,11p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
    *) echo "unknown option $a" >&2; exit 2 ;;
  esac
done

say() { echo "omarchy-osk: $*"; }

# patched plugin copies made by omarchy-osk-plugins: back to Omarchy's own
unpatch() {
  local m dir src name
  for m in "$PLUGINS"/*/manifest.json; do
    [[ -f $m ]] || continue
    src=$(jq -r '.omarchy.clonedFrom // empty' "$m" 2>/dev/null)
    name=${src#omarchy.}
    [[ $name == menu || $name == image-picker || $name == lock ]] || continue
    [[ -f $STATE/plugins/$name.sum ]] || continue  # a copy you made yourself
    dir=$(dirname "$m")
    id=$(jq -r .id "$m")
    omarchy plugin remove "$id" --yes >/dev/null 2>&1 || rm -rf "$dir"
    omarchy plugin enable "$src" >/dev/null 2>&1 || say "turn $src back on with: omarchy plugin enable $src"
    rm -f "$STATE/plugins/$name.sum"
    say "back to Omarchy's own $name"
  done
  rm -f "$CONFIG_DIR/omarchy/hooks/post-update.d/omarchy-osk"
  if [[ -f $STATE/setup ]]; then
    sed -i '/^patches=/d' "$STATE/setup"
    echo "patches=no" >>"$STATE/setup"
  fi
}

if ((patches_only)); then
  unpatch
  exit 0
fi

if command -v systemctl >/dev/null; then
  systemctl --user disable --now omarchy-osk-autoshow.service >/dev/null 2>&1
fi
pkill -x omarchy-oskd 2>/dev/null

unpatch

if [[ -d $PLUGINS/omarchy-osk ]]; then
  omarchy plugin disable user.osk >/dev/null 2>&1
  rm -rf "$PLUGINS/omarchy-osk"
fi
rm -f "$CONFIG_DIR/omarchy/hooks/theme-set.d/omarchy-osk" "$CONFIG_DIR/omarchy/hooks/font-set.d/omarchy-osk"

if grep -q '^-- omarchy-osk: slide in' "$LAYER_FILE" 2>/dev/null; then
  # the block setup added, and the blank line before it
  sed -i '/^-- omarchy-osk: slide in/,/^-- end omarchy-osk$/d' "$LAYER_FILE"
  sed -i -e :a -e '/^\n*$/{$d;N;ba' -e '}' "$LAYER_FILE"
  hyprctl reload >/dev/null 2>&1 || true
elif grep -qF 'namespace = "^omarchy-osk$"' "$LAYER_FILE" 2>/dev/null; then
  say "the omarchy-osk layer rule in ${LAYER_FILE/#$HOME/\~} was not added by setup: remove it yourself if you like"
fi

if [[ -f $STATE/files ]]; then
  while IFS= read -r f; do
    [[ -n $f && $f == "$HOME"/* ]] && rm -f "$f"
  done <"$STATE/files"
fi
rm -rf "${XDG_DATA_HOME:-$HOME/.local/share}/omarchy-osk" "$PREFIX/lib/omarchy-osk" "$CACHE"
command -v systemctl >/dev/null && systemctl --user daemon-reload 2>/dev/null
rm -rf "$STATE"
rm -f "$PREFIX/bin/omarchy-osk-uninstall"

if ((purge)); then
  rm -rf "$CONFIG_DIR/omarchy-osk"
else
  [[ -d $CONFIG_DIR/omarchy-osk ]] && say "your settings stay in ${CONFIG_DIR/#$HOME/\~}/omarchy-osk (--purge removes them)"
fi
if [[ -e /etc/mkinitcpio.conf.d/omarchy_osk_unlock.conf ]]; then
  say "the boot passphrase keyboard (unl0kr) is still installed: remove it with unlock/uninstall.sh from the repository (needs sudo)"
fi
say "removed"
