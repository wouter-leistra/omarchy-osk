#!/bin/bash
# The on-screen keyboard on the lock screen (needs the Hyprland layer rule
# above_lock = 2, see the README).
#
#   omarchy-osk-lock lock     private mode, shown when the Type Cover is detached
#   omarchy-osk-lock show     show it on the lock screen
#   omarchy-osk-lock hide
#   omarchy-osk-lock unlock   back to normal typing, hidden

cover="${OSK_COVER_NAME:-Type Cover Keyboard}"

oskd() {
  pkill "-$1" -x omarchy-oskd
}

running() {
  pgrep -x omarchy-oskd >/dev/null
}

case "$1" in
lock)
  if ! running; then
    setsid -f omarchy-osk --hidden >/dev/null 2>&1
    # signals before it set up its handlers would end it
    for _ in $(seq 30); do running && break; sleep 0.1; done
    sleep 0.5
  fi
  oskd RTMIN+2
  grep -q "^N: Name=\".*$cover\"" /proc/bus/input/devices || oskd USR2
  ;;
show)
  oskd RTMIN+2
  oskd USR2
  ;;
hide)
  oskd USR1
  ;;
unlock)
  oskd USR1
  oskd RTMIN+3
  ;;
*)
  echo "usage: omarchy-osk-lock lock|show|hide|unlock" >&2
  exit 1
  ;;
esac
